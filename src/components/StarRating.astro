---
interface Props {
  rating?: number;
}

const rawRating = Number(Astro.props.rating ?? 0);
const rating = Number.isFinite(rawRating)
  ? Math.min(10, Math.max(0, rawRating))
  : 0;
const starValue = rating / 2;
const fills = Array.from(
  { length: 5 },
  (_, index) => Math.min(1, Math.max(0, starValue - index)) * 100,
);
---

<span class="star-rating" role="img" aria-label={`评分 ${rating} / 10`}>
  {fills.map((fill) => (
    <span class="star" aria-hidden="true" style={`--fill: ${fill}%`}>★</span>
  ))}
</span>

<style>
  .star-rating {
    display: inline-flex;
    gap: 2px;
    line-height: 1;
  }

  .star {
    background: linear-gradient(
      90deg,
      #f5c518 var(--fill),
      #cbd5e1 var(--fill)
    );
    background-clip: text;
    color: transparent;
    font-size: 0.9rem;
    -webkit-background-clip: text;
  }
</style>
