---
// src/pages/now.astro
import LayoutDefault from "~/layouts/LayoutDefault.astro";
import NeoDBCard from "~/components/NeoDBCard.astro";
import { fetchNeoDBShelf } from "~/utils/neodb-client.js";

// 1. 获取 Token (加了 process.env 双重保险，绝对读得到)
const AUTH_TOKEN = import.meta.env.NEODB_TOKEN || process.env.NEODB_TOKEN;

// 两个请求并行执行；失败或超时会返回空数组，不中断整站构建。
const [moviesResult, booksResult] = await Promise.all([
  fetchNeoDBShelf('movie', AUTH_TOKEN, { limit: 4, retries: 1 }),
  fetchNeoDBShelf('book', AUTH_TOKEN, { limit: 4, retries: 1 }),
]);
const recentMovies = moviesResult.data;
const recentBooks = booksResult.data;

// 自动获取构建日期
const lastModified = new Date().toISOString().split('T')[0];
---

<LayoutDefault title="Now" desc="大猫最近的生活、运动、工作和阅读观影状态">
  <article class="heti prose mx-auto">
    <h1>Now</h1>
    <p class="text-gray-500 italic">
      最后更新于：{lastModified}
    </p>
    
    <h3>📍 当前状态</h3>
    <ul>
      <li><strong>健康</strong> 突然发现我不仅很久没窜稀了，甚至很久鼻炎都没发作了。不知道是因为定期吃kefir还是拔了一直在发炎的两颗六号牙，也可能都有。</li>
      <li><strong>运动</strong> 八月底做了上额窦提升和植牙手术，为了让植体和骨头顺利结合，彻底歇菜3周。</li>
      <li><strong>工作</strong> 每周居家办公两天的方式彻底解放生产力！去公司三天我疯狂干活，在家两天我快乐躺平。</li>
      <li><strong>爱好</strong> 书荒中求推荐...</li>
      
    </ul>

    

    {/* 电影板块 */}
    {recentMovies.length > 0 && (
      <>
        <h3>🎬 最近看过</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-4">
          {recentMovies.map((record: any) => (
            <NeoDBCard record={record} />
          ))}
        </div>
      </>
    )}

    {/* 书籍板块 */}
    {recentBooks.length > 0 && (
      <>
        <h3>📚 最近读过</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-4">
          {recentBooks.map((record: any) => (
            <NeoDBCard record={record} />
          ))}
        </div>
      </>
    )}
    
    {/* 如果都没有数据，显示提示 */}
    {recentMovies.length === 0 && recentBooks.length === 0 && (
       <p class="text-gray-400 text-sm italic">暂时无法获取 NeoDB 数据，请稍后再试。</p>
    )}
    
  </article>
</LayoutDefault>
