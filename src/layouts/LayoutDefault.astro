---
import '~/styles/index.css'
// https://sivan.github.io/heti
import '~/styles/heti.min.css'
import Header from '~/components/Header.astro'
import Footer from '~/components/Footer.astro'
import { SEO } from 'astro-seo'
import { getImage } from 'astro:assets'

interface Props {
  title?: string
  desc?: string
  banner?: ImageMetadata | string
  type?: 'website' | 'article'
  pubDate?: Date
  categories?: string[]
  author?: string
}

const props = Astro.props
const themeConfig = Astro.locals.config
const { header } = Astro.locals.config

const title = props.title
  ? `${props.title} | ${themeConfig.title}`
  : themeConfig.title
const desc = props.desc?.trim() || themeConfig.desc
const canonical = new URL(
  Astro.url.pathname,
  Astro.site ?? themeConfig.website,
).toString()
const pageType = props.type ?? 'website'
const author = props.author ?? themeConfig.author

const remoteBanner = typeof props.banner === 'string' ? props.banner : undefined
const localBanner = typeof props.banner === 'string' ? undefined : props.banner
const image =
  localBanner &&
  (await getImage({
    src: localBanner,
    format: "jpeg"
  }))
const optimizedImage = remoteBanner ?? new URL(
  image?.src ?? '/damao-og-v2.jpg',
  Astro.site ?? themeConfig.website,
).toString()
const imageType = remoteBanner ? undefined : 'image/jpeg'
const imageWidth = remoteBanner ? undefined : image?.attributes.width ?? 1200
const imageHeight = remoteBanner ? undefined : image?.attributes.height ?? 630
const imageAlt = props.banner
  ? `${props.title ?? themeConfig.title}的题图`
  : `${themeConfig.title}的网站预览图`
---

<html lang="zh-CN">
  <head>
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      charset="utf-8"
      title={title}
      description={desc}
      canonical={canonical}
      extend={{
        link: [
          { rel: 'icon', href: '/favicon.svg', type: 'image/svg+xml' },
          { rel: 'alternate', href: '/atom.xml', type: 'application/atom+xml', title: themeConfig.title },
          { rel: 'sitemap', href: '/sitemap-index.xml', type: 'application/xml' },
        ],
      }}
      openGraph={{
        basic: {
          title: title,
          type: pageType,
          image: optimizedImage,
          url: canonical,
        },
        optional: {
          description: desc,
          locale: 'zh_CN',
          siteName: themeConfig.title,
        },
        image: {
          secureUrl: optimizedImage,
          type: imageType,
          width: imageWidth,
          height: imageHeight,
          alt: imageAlt,
        },
      }}
      twitter={{
        card: 'summary_large_image',
        site: header.twitter,
        creator: header.twitter,
        title,
        description: desc,
        image: optimizedImage,
        imageAlt,
      }}
    />
    <meta name="author" content={author} />
    {
      pageType === 'article' && props.pubDate && (
        <meta property="article:published_time" content={props.pubDate.toISOString()} />
      )
    }
    {
      pageType === 'article' &&
        props.categories?.map((category) => (
          <meta property="article:tag" content={category} />
        ))
    }
  </head>
  <body>
    <div un-max-lg="animate-fadein-down" un-lg="flex flex-row-reverse justify-between gap-4 px-8 mx-auto max-w-6xl" class="site-layout container contain-layout m-a">
      <div un-lg="sticky top-0 h-screen py-20 animate-fadein-left gap-8" un-lg:flex="~ col justify-between items-start gap-4" class="site-sidebar p-7.5">
        <Header data-layout-header="" />
        <Footer data-layout-footer="" />
      </div>
      <main un-lg="py-20 min-w-xl animate-fadein-down" class="site-main p-7.5">
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  @media (max-width: 1023px) {
    .site-layout {
      display: flex;
      flex-direction: column;
    }

    .site-sidebar {
      display: contents;
    }

    [data-layout-header] {
      order: 1;
      padding: 1.875rem;
    }

    .site-main {
      order: 2;
    }

    [data-layout-footer] {
      order: 3;
      padding: 1.875rem;
    }
  }
</style>
